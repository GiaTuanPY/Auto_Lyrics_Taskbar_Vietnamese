{
  "manifest_version": 3,
  "name": "Auto Lyrics Connector",
  "version": "1.1.0",
  "description": "Sends YouTube playback metadata to AutoLyricsOverlay.",
  "permissions": ["scripting"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://www.youtube.com/*",
    "https://music.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}